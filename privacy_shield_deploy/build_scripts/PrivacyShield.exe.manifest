<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  PrivacyShield.exe.manifest
  ──────────────────────────
  Windows application manifest.
  • Declares camera / webcam device capability so Windows 10/11 shows the
    "Allow PrivacyShield to access your camera?" permission dialog.
  • Place next to PrivacyShield.exe  — OR embed via PyInstaller (see below).

  To embed into the EXE during build:
      mt.exe -manifest PrivacyShield.exe.manifest -outputresource:PrivacyShield.exe;1

  PyInstaller users: pass this file as manifest flag (using two dashes):
      pyinstaller [two dashes]manifest build_scripts/PrivacyShield.exe.manifest app.py
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">

  <assemblyIdentity
    type="win32"
    name="com.yourname.PrivacyShield"
    version="1.0.0.0"
    processorArchitecture="*"/>

  <description>Privacy Shield — Real-Time Video Call Protector</description>

  <!-- DPI awareness -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
        PerMonitorV2
      </dpiAwareness>
    </windowsSettings>
  </application>

  <!-- Windows 10 / 11 device capability: Camera -->
  <Capabilities>
    <DeviceCapability Name="camera">
      <Device Id="*">
        <Function Type="video" SubType="capture"/>
      </Device>
    </DeviceCapability>
  </Capabilities>

  <!-- Compatibility GUIDs -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
    </application>
  </compatibility>

  <!-- Execution level -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

</assembly>
